{
  "extends": "default",
  "meta": {
    "name": "tmux",
    "version": "1.0.0",
    "description": "Read-only access to Tmux config; no CWD grant"
  },
  "filesystem": {
    "read": [
      "$HOME/.tmux",
      "$HOME/.local/share/tmux/"
    ],
    "read_file": [
      // "$HOME/.tmux.conf"
      "$HOME/data/zr/mini_home/.tmux.conf"

    ]
  }
}
