{
  "extends": "default",
  "meta": {
    "name": "nvim",
    "version": "1.0.0",
    "description": "Read-only access to Neovim config; no CWD grant"
  },
  "filesystem": {
    "read": [
      "$XDG_CONFIG_HOME/nvim",
      "~/.local/share/nvim"
      // "~/.local/share/nvim/python_venv_for_nvim"
    ]
  }
}
