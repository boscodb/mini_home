{
  "extends": [
    // "nolabs-ai/pi",
    "nolabs-ai/claude",
    "common"
  ],
  "meta": {
    "name": "rocky-local",
    "version": "1.0.2",
    "description": "Rocky Coding Agent",
    "author": "sage"
  },
  "security": {
    "signal_mode": null,
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": null,
    "wsl2_proxy_policy": null
  },
  "groups": {
    "include": [],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "filesystem": {
    "allow": [
      "/tmp/jiti",
      "/etc/apt",
      "/etc/apt/sources.list.d",
      "/var/lib/dpkg"
    ],
    "read": [
      "/tmp/claude-$UID",
      "$HOME/data/zr/workspaces/pi__spaces/pi",
      "$HOME/data/zr/workspaces/mini_home__spaces/mini_home/dotfiles__restricted_by_nono_defaults/.npmrc"
    ],
    "write": [],
    "allow_file": [],
    "read_file": [],
    "write_file": [],
    "unix_socket": [],
    "unix_socket_bind": [],
    "unix_socket_dir": [],
    "unix_socket_dir_bind": [],
    "unix_socket_subtree": [],
    "unix_socket_subtree_bind": [],
    "deny": [],
    "bypass_protection": [
      "$HOME/data/zr/workspaces/mini_home__spaces/mini_home/dotfiles__restricted_by_nono_defaults/.npmrc"
    ],
    "suppress_save_prompt": []
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [],
    "deny_domain": [],
    "open_port": [],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {},
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": []
  },
  "diagnostics": {
    "suppress_system_services": []
  },
  "linux": {
    "af_unix_mediation": null,
    "sandbox_policy": null
  },
  "env_credentials": {},
  "credential_capture": {},
  "credential_providers": {},
  "credential_routes": [],
  "workdir": {
    "access": "readwrite"
  },
  "hooks": {},
  "session_hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  },
  "interactive": false,
  "skipdirs": [],
  "packs": [],
  "command_args": [],
  "unsafe_macos_seatbelt_rules": []
}
