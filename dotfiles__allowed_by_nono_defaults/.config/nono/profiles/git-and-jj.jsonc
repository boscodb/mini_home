{
  "extends": "default",
  "meta": {
    "name": "git-and-jj",
    "version": "1.0.0",
    "description": "Jujutsu (jj) VCS support",
    "author": "sage"
  },
  "groups": {
    "include": [
      "git_config"
    ]
  },
  "filesystem": {
    "read": [
      "$HOME/.config/jj",
      "$HOME/.config/gh" // For Github CLI
    ]
  }
}
